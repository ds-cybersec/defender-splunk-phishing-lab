# ==========================================
# MULTI-LAYER EMAIL SECURITY & SIEM LAB SPL
# ==========================================

# Scenario 1: Baseline Successful Authentication (Entra ID)
index=main sourcetype=_json operation="UserLoggedIn"
| table _time ClientIP UserKey resultStatus Workload

# Scenario 2: Failed Login / Credential Harvesting Phishing Simulation (Entra ID)
index=main sourcetype=_json operation="UserLoginFailed"
| table _time ClientIP SenderAddress Subject resultStatus

# Scenario 3: Email Spoofing & DMARC Failure - Blocked by EOP
index=main sourcetype=_json operation="MessageBlocked"
| table _time SenderAddress RecipientAddress ThreatDetection DeliveryAction

# Scenario 4: Data Loss Prevention (DLP) Policy Violation (Purview)
index=main sourcetype=_json operation="DlpRuleMatch"
| table _time SenderAddress RecipientAddress PolicyName ActionTaken
